rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /fitnessBackups/{userId} {
      function isVerifiedOwner() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true;
      }

      function isValidSingleDocBackup() {
        return (
          request.resource.data.keys().hasOnly(['version', 'exportedAt', 'backup', 'updatedAt', 'isChunked'])
          && (!('isChunked' in request.resource.data) || request.resource.data.isChunked == false)
          && request.resource.data.backup is map
          && request.resource.data.backup.version == '4.0'
          && request.resource.data.version == '4.0'
        );
      }

      function isValidChunkedManifest() {
        return (
          request.resource.data.keys().hasOnly(['version', 'exportedAt', 'isChunked', 'chunkCount', 'totalBytes', 'updatedAt'])
          && request.resource.data.isChunked == true
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount > 0
          && request.resource.data.totalBytes is int
          && request.resource.data.totalBytes > 0
          && request.resource.data.version == '4.0'
        );
      }

      allow get: if isVerifiedOwner();
      allow list: if false;
      allow create, update: if isVerifiedOwner()
        && (isValidSingleDocBackup() || isValidChunkedManifest());
      allow delete: if isVerifiedOwner();

      match /chunks/{chunkId} {
        allow get, list: if isVerifiedOwner();
        allow create, update: if isVerifiedOwner()
          && request.resource.data.keys().hasOnly(['index', 'totalChunks', 'chunk', 'updatedAt'])
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.totalChunks is int
          && request.resource.data.totalChunks > 0
          && request.resource.data.chunk is string;
        allow delete: if isVerifiedOwner();
      }
    }

    match /foodRequests/{requestId} {
      function isVerifiedUser() {
        return request.auth != null
          && request.auth.token.email_verified == true;
      }

      function isValidFoodRequest() {
        return (
          request.resource.data.keys().hasOnly(['userId', 'foodName', 'brand', 'notes', 'barcode', 'createdAt', 'status'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.foodName is string
          && request.resource.data.foodName.size() >= 1
          && request.resource.data.foodName.size() <= 200
          && (!('brand' in request.resource.data) || (request.resource.data.brand is string && request.resource.data.brand.size() <= 200))
          && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500))
          && (!('barcode' in request.resource.data) || (request.resource.data.barcode is string && request.resource.data.barcode.size() <= 50))
          && request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 40
          && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'reviewed', 'approved', 'rejected'])
        );
      }

      allow get: if request.auth != null && resource.data.userId == request.auth.uid;
      allow list: if false;
      allow create: if isVerifiedUser() && isValidFoodRequest();
      allow update, delete: if false;
    }
  }
}
