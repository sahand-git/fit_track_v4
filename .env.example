EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Use the web OAuth client ID generated in the same Google/Firebase project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Native Google sign-in configuration. Put service files in the project root,
# or set these to their build-time paths. Do not commit private backend keys.
GOOGLE_ANDROID_SERVICES_FILE=
GOOGLE_IOS_SERVICES_FILE=
GOOGLE_IOS_URL_SCHEME=
