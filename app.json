{
  "expo": {
    "name": "FitTrack",
    "slug": "fittrack-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F2",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fittrack.expo"
    },
    "android": {
      "package": "com.fittrack.expo",
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "FitTrack needs access to your camera to scan barcodes and photograph meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitTrack needs access to your photos to analyze meal images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1E3A2F"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "@appeeky/expo-healthkit",
        {
          "healthSharePermission": "FitTrack reads your daily step totals to show activity progress.",
          "healthUpdatePermission": "FitTrack does not write health data to Apple Health.",
          "healthConnectPermissions": ["READ_STEPS"]
        }
      ]
    ]
  }
}
